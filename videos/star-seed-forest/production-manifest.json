      "shotId": "01-start-shot-2",
      "speaker": "叶芽",
      "role": "primary",
      "kind": "dialogue",
      "text": "别怕，我会保护这颗星种。",
      "startSeconds": 5.19,
      "endSeconds": 8.43
    },
    {
      "id": "01-start-line-3-caption-1",
      "sceneId": "01-start",
      "lineId": "01-start-line-3",
      "shotId": "01-start-shot-3",
      "speaker": "小鹿",
      "role": "secondary",
      "kind": "dialogue",
      "text": "最高的古树还在等它。",
      "startSeconds": 8.85,
      "endSeconds": 11.37
    },
    {
      "id": "02-middle-line-1-caption-1",
      "sceneId": "02-middle",
      "lineId": "02-middle-line-1",
      "shotId": "02-middle-shot-1",
      "speaker": "旁白",
      "role": "narrator",
      "kind": "narration",
      "text": "叶芽和小鹿顶着风雨穿过森林。",
      "startSeconds": 12.95,
      "endSeconds": 16.646
    },
    {
      "id": "02-middle-line-2-caption-1",
      "sceneId": "02-middle",
      "lineId": "02-middle-line-2",
      "shotId": "02-middle-shot-2",
      "speaker": "叶芽",
      "role": "primary",
      "kind": "dialogue",
      "text": "风雨再大，也不能让星种熄灭。",
      "startSeconds": 17.066,
      "endSeconds": 20.642
    },
    {
      "id": "02-middle-line-3-caption-1",
      "sceneId": "02-middle",
      "lineId": "02-middle-line-3",
      "shotId": "02-middle-shot-3",
      "speaker": "小鹿",
      "role": "secondary",
      "kind": "dialogue",
      "text": "跟紧我，我们越过前面的断木！",
      "startSeconds": 21.062,
      "endSeconds": 24.302
    },
    {
      "id": "03-end-line-1-caption-1",
      "sceneId": "03-end",
      "lineId": "03-end-line-1",
      "shotId": "03-end-shot-1",
      "speaker": "旁白",
      "role": "narrator",
      "kind": "narration",
      "text": "星种在古树顶端开成漫天星花。",
      "startSeconds": 25.95,
      "endSeconds": 29.718
    },
    {
      "id": "03-end-line-2-caption-1",
      "sceneId": "03-end",
      "lineId": "03-end-line-2",
      "shotId": "03-end-shot-2",
      "speaker": "叶芽",
      "role": "primary",
      "kind": "dialogue",
      "text": "我们做到了，",
      "startSeconds": 30.138,
      "endSeconds": 31.5588
    },
    {
      "id": "03-end-line-2-caption-2",
      "sceneId": "03-end",
      "lineId": "03-end-line-2",
      "shotId": "03-end-shot-2",
      "speaker": "叶芽",
      "role": "primary",
      "kind": "dialogue",
      "text": "森林重新亮起来了！",
      "startSeconds": 31.5588,
      "endSeconds": 33.69
    },
    {
      "id": "03-end-line-3-caption-1",
      "sceneId": "03-end",
      "lineId": "03-end-line-3",
      "shotId": "03-end-shot-3",
      "speaker": "猫头鹰",
      "role": "tertiary",
      "kind": "dialogue",
      "text": "星花开满天空啦！",
      "startSeconds": 34.11,
      "endSeconds": 36.798
    }
  ],
