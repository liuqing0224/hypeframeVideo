      "id": "01-start",
      "index": 1,
      "beat": "start",
      "title": "微弱星种",
      "narration": "守林人叶芽发现夜晚森林失去星光，小鹿从黑暗中带来一颗微弱发亮的星种。",
      "transitionIn": "cut",
      "motionRules": [
        "multi-phase-camera",
        "waterfall-entry",
        "sine-wave-loop"
      ],
      "direction": "right",
      "sourceDirection": "right",
      "shot": {
        "title": "微弱星种",
        "primary": "穿绿色斗篷、戴叶片帽的少年守林人叶芽，双手接住微弱发光的星种",
        "secondary": "一只带白色斑点的小鹿，低头把星种送到叶芽面前",
        "tertiary": "一只圆滚滚的小猫头鹰停在树枝上担忧地望着森林",
        "rear": "没有星光的深夜森林与沉默山影",
        "architecture": "森林中央枯暗的巨大古树和盘绕树根",
        "foreground": "近处黑色叶片、蕨类与少量微弱萤火虫",
        "direction": "right"
      },
