      "index": 2,
      "beat": "middle",
      "title": "风雨护送",
      "narration": "叶芽和小鹿顶着风雨穿过森林，把星种护送到最高古树的树冠。",
      "transitionIn": "blur-through",
      "motionRules": [
        "coordinate-target-zoom",
        "motion-blur-streak",
        "reactive-displacement"
      ],
      "direction": "right",
      "sourceDirection": "right",
      "shot": {
        "title": "风雨护送",
        "primary": "叶芽弯腰护住怀里的星种，在强风中向前攀爬",
        "secondary": "小鹿顶着雨水跳过倒下的树干为叶芽引路",
        "tertiary": "猫头鹰贴近树梢飞行并回头指引方向",
        "rear": "暴雨中的层叠森林、闪电与远处古树树冠",
        "architecture": "通往古树顶端的藤蔓阶梯和断裂树桥",
        "foreground": "横扫镜头的雨线、摇摆枝叶与飞溅水滴",
